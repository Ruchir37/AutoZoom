public static Properties loadProperties() {

    Properties prop = null;
    InputStream inputStream = null;

    if (ENVIRONMENT == null || ENVIRONMENT.trim().equals("")) {
        ENVIRONMENT = "local";
    }

    String propName = "env_" + ENVIRONMENT + ".properties";

    try {
        prop = new Properties();

        inputStream =
            PropertiesUtil.class
                .getClassLoader()
                .getResourceAsStream(propName);

        if (inputStream == null) {
            throw new FileNotFoundException(
                "Property file not found in classpath: " + propName
            );
        }

        prop.load(inputStream);

    } catch (Exception ex) {
        ex.printStackTrace();
        prop = null;

    } finally {
        try {
            if (inputStream != null) {
                inputStream.close();
            }
        } catch (Exception ex) {
            ex.printStackTrace();
        }
    }

    return prop;
}
