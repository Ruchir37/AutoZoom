static {
    try {
        prop = new Properties();

        try (InputStream inputStream =
                     SecurityUtil.class.getClassLoader()
                         .getResourceAsStream("config.properties")) {

            if (inputStream == null) {
                throw new IllegalStateException(
                    "config.properties not found in classpath");
            }

            prop.load(inputStream);
        }

        try (InputStream inputStream1 =
                     SecurityUtil.class.getClassLoader()
                         .getResourceAsStream("key.properties")) {

            if (inputStream1 == null) {
                throw new IllegalStateException(
                    "key.properties not found in classpath");
            }

            prop.load(inputStream1);
        }

    } catch (Exception ex) {
        ex.printStackTrace();
        throw new ExceptionInInitializerError(ex);
    }
}
