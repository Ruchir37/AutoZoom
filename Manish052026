static Properties prop;

static {
    try {
        prop = new Properties();

        InputStream inputStream =
                VTransactUtil.class
                        .getClassLoader()
                        .getResourceAsStream("EmailContent.properties");

        if (inputStream == null) {
            throw new FileNotFoundException(
                    "EmailContent.properties not found in classpath"
            );
        }

        prop.load(inputStream);

    } catch (Exception ex) {
        Log.doLog(LOGC.LTE, "VTransactUtil",
                "VTransactUtil Static Block",
                "Error: Failed to read property file. Exception Stack : "
                        + getStackTrace(ex), "", "", "");
    }
}
