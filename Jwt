

private boolean isTokenValid(HttpServletRequest request) {
    jakarta.servlet.http.HttpSession session = request.getSession(false);

    if (session == null) {
        return false;
    }

    Object sessionJwt = session.getAttribute("JWT_TOKEN");
    String requestJwt = request.getParameter("JWT_TOKEN");

    if (!(sessionJwt instanceof String)
            || ((String) sessionJwt).isBlank()
            || requestJwt == null
            || requestJwt.isBlank()) {
        return false;
    }

    // The submitted JWT must match the JWT issued for this session.
    if (!sessionJwt.equals(requestJwt)) {
        return false;
    }

    try {
        Claims claims = jwtTokenService.validateToken(requestJwt);
        return claims.getSubject() != null
                && !claims.getSubject().isBlank();
    } catch (Exception ex) {
        return false;
    }
}
