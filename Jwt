<form:form id="reportForm" name="reportForm"
    modelAttribute="searchCriteriaDTO"
    commandName="searchCriteriaDTO"
    action="${searchCusAndMerchantReport}" autocomplete="off"
    onsubmit="removeSpace(this); encodeForm(this);">

    <input type="hidden" name="JWT_TOKEN"
           value="${sessionScope.JWT_TOKEN}" />

    <form:hidden path="reportName" id="reportName"
        value="${searchCriteriaDTO.reportName}" />
