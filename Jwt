
@Override
public Map<String, String> getExtraHiddenFields(
        jakarta.servlet.http.HttpServletRequest request) {

    Map<String, String> hiddenFields = new HashMap<>();

    jakarta.servlet.http.HttpSession session = request.getSession(false);

    if (session != null) {
        Object jwt = session.getAttribute("JWT_TOKEN");

        if (jwt instanceof String && !((String) jwt).isBlank()) {
            hiddenFields.put("JWT_TOKEN", (String) jwt);
        }
    }

    return hiddenFields;
}




function urlPostAction(type, action) {
    var tokenElement = document.getElementsByName("JWT_TOKEN")[0];

    if (!tokenElement || !tokenElement.value) {
        console.error("JWT token is missing.");
        return;
    }

    postData(action, "JWT_TOKEN," + tokenElement.value);
}
