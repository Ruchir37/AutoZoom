package com.vTransact.adminportal.filter;

import java.io.IOException;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import org.springframework.web.filter.OncePerRequestFilter;

import com.vTransact.adminportal.security.JwtTokenService;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@Component
public class JwtValidationFilter extends OncePerRequestFilter {

private static final Logger log =
        LoggerFactory.getLogger(JwtValidationFilter.class);

private final JwtTokenService jwtTokenService;

public JwtValidationFilter(JwtTokenService jwtTokenService) {
    this.jwtTokenService = jwtTokenService;
}

@Override
protected void doFilterInternal(
        HttpServletRequest request,
        HttpServletResponse response,
        FilterChain filterChain)
        throws ServletException, IOException {

    HttpSession session = request.getSession(false);

    if (session == null) {
        log.debug("JWT check: no existing session for {}",
                request.getRequestURI());
        filterChain.doFilter(request, response);
        return;
    }

    Object tokenObject = session.getAttribute("JWT_TOKEN");

    if (!(tokenObject instanceof String)) {
        log.debug("JWT check: no JWT in session for {}",
                request.getRequestURI());
        filterChain.doFilter(request, response);
        return;
    }

    String token = (String) tokenObject;

    try {
        jwtTokenService.validateToken(token);
        log.info("JWT validation passed for request: {}",
                request.getRequestURI());
    } catch (Exception ex) {
        log.warn("JWT validation failed for request: {}",
                request.getRequestURI());
    }

    // Monitoring only: do not block existing requests yet.
    filterChain.doFilter(request, response);
}

}
