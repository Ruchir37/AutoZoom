
private boolean isAjaxTokenValid(HttpServletRequest request) {
    jakarta.servlet.http.HttpSession session = request.getSession(false);

    if (session == null) {
        return false;
    }

    Object sessionJwt = session.getAttribute("JWT_TOKEN");

    // Accept JWT from the Authorization header.
    String requestJwt = request.getHeader("Authorization");

    if (requestJwt != null && requestJwt.startsWith("Bearer ")) {
        requestJwt = requestJwt.substring(7).trim();
    } else {
        requestJwt = request.getParameter("JWT_TOKEN");
    }

    if (!(sessionJwt instanceof String)
            || ((String) sessionJwt).isBlank()
            || requestJwt == null
            || requestJwt.isBlank()) {
        return false;
    }

    if (!sessionJwt.equals(requestJwt)) {
        return false;
    }

    try {
        Claims claims = jwtTokenService.validateToken(requestJwt);
        return claims.getSubject() != null
                && !claims.getSubject().isBlank();
    } catch (Exception ex) {
        return false;
    }
}
