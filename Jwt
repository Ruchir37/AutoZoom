HttpSession session = request.getSession(false);

if (session == null) {
    log.warn("JWT rejected: no session for {}",
            request.getRequestURI());

    response.sendError(
            HttpServletResponse.SC_UNAUTHORIZED,
            "Authentication required: no session");
    return;
}

Object tokenObject = session.getAttribute("JWT_TOKEN");

if (!(tokenObject instanceof String)
        || ((String) tokenObject).isBlank()) {

    log.warn("JWT rejected: missing token for {}",
            request.getRequestURI());

    response.sendError(
            HttpServletResponse.SC_UNAUTHORIZED,
            "Authentication required: JWT missing");
    return;
}

String token = (String) tokenObject;
