
<RelativeLayout
    android:id="@+id/alternateMobileLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible">

    <!-- Mobile icon + input -->
    <LinearLayout
        android:id="@+id/mobileInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/alternativeMobileImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_mobile"
            android:contentDescription="Mobile number" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/alternativeMobileTextInputLayout"
            style="@style/MediumBlackInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/alternateMobileEditText"
                style="@style/MediumBlackEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:hint="@string/alternative_number"
                android:inputType="number"
                android:maxLength="10"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceMedium" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- OTP information -->
    <TextView
        android:id="@+id/alternateMobileHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/mobileInputContainer"
        android:layout_marginTop="8dp"
        android:text="OTP will be generated and sent on your primary mobile number"
        android:textColor="#757575"
        android:textSize="14sp" />

</RelativeLayout>
