
<RelativeLayout
    android:id="@+id/alternateMobileLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/alternativeMobileTextInputLayout"
        style="@style/MediumBlackInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:startIconDrawable="@drawable/ic_mobile">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alternateMobileEditText"
            style="@style/MediumBlackEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:hint="Alternate Mobile Number"
            android:inputType="number"
            android:maxLength="10"
            android:textAppearance="?android:attr/textAppearanceMedium" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- OTP Instruction -->
    <TextView
        android:id="@+id/alternateMobileHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/alternativeMobileTextInputLayout"
        android:layout_marginTop="4dp"
        android:text="OTP will be generated and sent on your primary mobile number"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:visibility="visible" />

</RelativeLayout>
